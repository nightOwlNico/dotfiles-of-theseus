{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": {
      "top": 2
    }
  },
  "display": {
    "temp": {
      "unit": "Fahrenheit"
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "battery",
      "temp": true
    },
    {
      "type": "cpu",
      "showPeCoreCount": true,
      "temp": true
    },
    "cpuusage",
    "memory",
    {
      "type": "gpu",
      "driverSpecific": true,
      "temp": true
    },
    {
      "type": "physicaldisk",
      "temp": true
    },
    "disk",
    "os",
    "kernel",
    "vulkan",
    "opengl",
    "opencl",
    "users",
    "uptime",
    "shell",
    "break",
    "colors"
  ]
}
