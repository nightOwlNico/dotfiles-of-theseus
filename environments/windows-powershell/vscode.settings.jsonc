  "workbench.iconTheme": "vira-icons-carbon",
  "viraTheme.accent": "Lime",
  // ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  // ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  // ============================Personal Extensions============================
  "gitlens.currentLine.enabled": false,
  "gitlens.codeLens.enabled": false,
  // "highlight-matching-tag.highlightFromContent": true,
  // "highlight-matching-tag.highlightSelfClosing": true,
  // "highlight-matching-tag.styles": {
  //   "opening": {
  //     "name": {
  //       "underline": "#FFFF00"
  //     }
  //   }w
  // },
  "indentRainbow.colors": 
  [
    "rgba(0,0,0,0)",
    "rgba(0,0,0,.33)",
    "rgba(0,0,0,.66)",
    "rgba(0,0,0,.99)"
  ],
  // ===================== INDENT RAINBOW RIGHT-BORDER HACK DOC ====================
  // Why these two settings are changed together:
  // 1) "indentRainbow.indicatorStyle": "light"
  //    - Switches indent-rainbow from full background fill to a border indicator style.
  // 2) "indentRainbow.lightIndicatorStyleLineWidth": 17.5
  //    - Makes the border indicator visually close to the old fill width.
  //
  // Required local extension source patch (outside this workspace):
  // C:\Users\Nico\.vscode\extensions\oderwat.indent-rainbow-8.3.1\out\src\extension.js
  // In activate(), under: else if (indicatorStyle === 'light')
  // borderWidth changed from left-border slot to right-border slot.
  // Before: 0 0 0 [lineWidth]px
  // After:  0 [lineWidth]px 0 0
  //
  // Why that source patch is the only reason these settings are used:
  // - With the default left-side border, VS Code vertical guides can be obscured.
  // - Moving the border to the right keeps indent guides and bracket-pair guides visible.
  // - Therefore, these two settings intentionally depend on that local source hack.
  "indentRainbow.indicatorStyle": "light",
  "indentRainbow.lightIndicatorStyleLineWidth": 17.5,
  // =================== END INDENT RAINBOW RIGHT-BORDER HACK DOC ==================
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.tokenColorCustomizations": {},
  "workbench.secondarySideBar.defaultVisibility": "visible",
  "chat.viewSessions.orientation": "stacked",
  "workbench.productIconTheme": "viraUIIcons",
  // ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
}
